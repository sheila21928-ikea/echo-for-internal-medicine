<!DOCTYPE html>
<html lang="zh-Hant">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>腹部超音波課前需求調查 · 分析報告</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Noto+Serif+TC:wght@600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3"></script>
<style>
:root{
  --bg:#050c1d; --panel:#0b162d; --panel-soft:#101f3e;
  --text:#e8f1ff; --muted:#9db0cc;
  --teal:#63d6e6; --gold:#e3c784; --rose:#e7a7a4;
  --line:#1f335f;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{
  margin:0; font-family:Inter,"Noto Sans TC",system-ui,sans-serif; font-size:17px;
  line-height:1.7; color:var(--text);
  background:radial-gradient(circle at 20% 10%, #0e2144 0%, var(--bg) 50%), var(--bg);
}
.stars::before{
  content:""; position:fixed; inset:0; pointer-events:none; z-index:0;
  background-image:radial-gradient(#7ccfe566 1px, transparent 1px);
  background-size:160px 160px; opacity:.5;
}
.wrap{position:relative; z-index:1; width:min(1080px, calc(100% - 48px)); margin:0 auto}
h1,h2{font-family:"Noto Serif TC",serif; line-height:1.15; margin:0}
.label{font-size:.74rem; font-weight:600; color:var(--rose); text-transform:uppercase; letter-spacing:.38em}
.chapnum{font-size:.74rem; font-weight:600; color:var(--teal); text-transform:uppercase; letter-spacing:.38em}
.lead{color:var(--muted); max-width:720px; margin:14px auto 0; font-size:1.05rem}

/* HERO */
header.hero{min-height:85vh; display:grid; place-items:center; text-align:center; padding:60px 0}
header.hero h1{font-size:clamp(2.2rem,7vw,4.6rem); font-weight:700; margin:22px 0 0}
header.hero .sub{color:var(--muted); max-width:640px; margin:18px auto 0}
.heartbeat{position:relative; width:min(860px,100%); height:2px; margin:36px auto 0;
  background:linear-gradient(90deg,transparent,var(--teal),transparent)}
.heartbeat::after{
  content:""; position:absolute; left:0; right:0; top:-14px; height:30px;
  background:linear-gradient(90deg,transparent,var(--teal),transparent); opacity:.55;
  clip-path:polygon(0 50%,20% 50%,30% 20%,40% 80%,50% 20%,60% 80%,70% 50%,100% 50%,100% 100%,0 100%);
}
.meta-strip{display:flex; gap:26px; justify-content:center; flex-wrap:wrap; margin-top:34px; color:var(--muted); font-size:.85rem; letter-spacing:.08em}
.meta-strip b{color:var(--gold); font-weight:600}

/* SECTIONS */
section{padding:86px 0; scroll-margin-top:40px}
section > .wrap > .head{text-align:center; margin-bottom:44px}
section h2{font-size:clamp(1.8rem,4.6vw,3rem); font-weight:600; margin-top:12px}

.panel{
  background:linear-gradient(160deg,#0e1a34,#091226); border:1px solid var(--line);
  border-radius:16px; padding:24px; box-shadow:0 16px 32px rgba(0,0,0,.25);
}
.panel h3{font-size:.8rem; font-weight:600; color:#d5e7ff; text-transform:uppercase; letter-spacing:.24em; margin:0 0 16px}
.grid2{display:grid; grid-template-columns:repeat(auto-fit,minmax(320px,1fr)); gap:20px}
.chart-box{height:320px; position:relative}
.chart-box.tall{height:380px}

/* KPI */
.kpi-grid{display:grid; grid-template-columns:repeat(auto-fit,minmax(170px,1fr)); gap:16px}
.kpi{
  text-align:left; cursor:pointer; font-family:inherit; color:inherit;
  background:linear-gradient(160deg,#0e1a34,#091226); border:1px solid var(--line);
  border-radius:14px; padding:18px; transition:.22s;
}
.kpi:hover,.kpi[aria-expanded="true"]{border-color:var(--teal); box-shadow:0 0 12px #63d6e699}
.kpi .n{font-size:2rem; font-weight:700; color:#f1f7ff; line-height:1.1}
.kpi .n small{font-size:.9rem; color:var(--muted); font-weight:500}
.kpi .t{font-size:.72rem; color:var(--rose); text-transform:uppercase; letter-spacing:.2em; margin-top:8px}
.kpi .d{display:none; margin-top:12px; padding-top:12px; border-top:1px solid var(--line); font-size:.88rem; color:var(--muted); line-height:1.6}
.kpi[aria-expanded="true"] .d{display:block}

/* mini cards */
.mini-grid{display:grid; grid-template-columns:repeat(auto-fit,minmax(210px,1fr)); gap:16px; margin-top:20px}
.mini{background:var(--panel); border:1px solid var(--line); border-radius:12px; padding:16px}
.mini h4{margin:0 0 6px; color:var(--gold); font-size:.95rem}
.mini p{margin:0; font-size:.86rem; color:var(--muted)}

/* filters + table */
.filters{display:flex; gap:10px; flex-wrap:wrap; margin-bottom:18px}
.filter-btn{
  border-radius:999px; padding:7px 16px; font-size:.82rem; font-family:inherit; cursor:pointer;
  background:transparent; color:var(--muted); border:1px solid var(--line); transition:.2s;
}
.filter-btn:hover{color:var(--text); border-color:var(--teal)}
.filter-btn.active{background:var(--teal); color:#04121f; border-color:var(--teal); font-weight:600}
.tbl-scroll{overflow-x:auto}
table{width:100%; border-collapse:collapse; font-size:.88rem; min-width:640px}
th,td{border-bottom:1px solid var(--line); padding:11px 10px; text-align:left; vertical-align:top}
th{color:#d5e7ff; font-size:.72rem; text-transform:uppercase; letter-spacing:.14em; font-weight:600}
td.num{color:var(--gold); font-weight:600; text-align:center; width:52px}
tbody tr:hover{background:#101f3e88}
.pill{display:inline-block; font-size:.74rem; padding:2px 9px; border-radius:999px; border:1px solid var(--line); color:var(--muted)}
.pill.ind{color:var(--teal); border-color:#63d6e655}
.pill.sup{color:var(--gold); border-color:#e3c78455}
.pill.saw{color:var(--rose); border-color:#e7a7a455}

/* quotes */
.quote-grid{display:grid; grid-template-columns:repeat(auto-fit,minmax(260px,1fr)); gap:14px}
.quote{background:var(--panel); border:1px solid var(--line); border-left:3px solid var(--teal); border-radius:10px; padding:14px 16px; font-size:.9rem}
.quote .who{display:block; font-size:.68rem; color:var(--rose); letter-spacing:.22em; text-transform:uppercase; margin-bottom:6px}

/* callouts */
.findings{background:#e3c7840f; border-left:4px solid var(--gold); border-radius:0 12px 12px 0; padding:20px 24px; margin-top:24px}
.findings h3{color:var(--gold); margin:0 0 10px; font-size:.8rem; letter-spacing:.24em; text-transform:uppercase}
.findings ul{margin:0; padding-left:20px}
.findings li{margin-bottom:8px}
.verdict{background:var(--panel); border-left:3px solid var(--teal); border-radius:0 12px 12px 0; padding:22px 26px; margin-top:26px}
.verdict b{color:var(--gold)}
.duo{display:grid; grid-template-columns:repeat(auto-fit,minmax(300px,1fr)); gap:20px; margin-top:22px}
.duo .panel h3.ok{color:var(--teal)}
.duo .panel h3.gap{color:var(--rose)}
.duo ul{margin:0; padding-left:20px; font-size:.92rem; color:var(--muted)}
.duo li{margin-bottom:8px}
.duo li b{color:var(--text); font-weight:600}

/* side rail */
.rail{position:fixed; left:22px; top:50%; transform:translateY(-50%); display:flex; flex-direction:column; gap:14px; z-index:5}
.rail a{width:10px; height:10px; border-radius:50%; border:1px solid #3d5a92; display:block; transition:.25s}
.rail a:hover,.rail a.active{background:var(--teal); border-color:var(--teal); box-shadow:0 0 12px #63d6e699}

footer{text-align:center; padding:70px 0 90px; color:var(--muted); font-size:.84rem}
footer .heartbeat{margin-bottom:26px}

@media(max-width:880px){
  .rail{display:none}
  body{font-size:16px}
  .chart-box{height:270px}
  .chart-box.tall{height:330px}
  section{padding:64px 0}
}
</style>
</head>
<body class="stars">

<nav class="rail" aria-label="章節導覽">
  <a href="#hero" class="active" title="首頁"></a>
  <a href="#c1" title="參與者輪廓"></a>
  <a href="#c2" title="技能基線"></a>
  <a href="#c3" title="自我效能"></a>
  <a href="#c4" title="學習動機"></a>
  <a href="#c5" title="質性期待"></a>
  <a href="#c6" title="課程設計啟示"></a>
</nav>

<header class="hero" id="hero">
  <div class="wrap">
    <span class="label">Pre-Course Needs Assessment</span>
    <h1>腹部超音波課前<br>需求與自我效能調查</h1>
    <p class="sub">21 位內科住院醫師與 PGY2 學員的技能基線、信心分佈與學習期待——為 POCUS 課程設計提供實證起點。</p>
    <div class="heartbeat"></div>
    <div class="meta-strip">
      <span>有效樣本 <b>21</b></span>
      <span>收案期間 <b>2026/1/4 – 1/29</b></span>
      <span>題項 <b>10</b></span>
      <span>信心量表 <b>Likert 1–5</b></span>
    </div>
  </div>
</header>

<!-- CHAPTER I -->
<section id="c1">
  <div class="wrap">
    <div class="head">
      <span class="chapnum">Chapter I</span>
      <h2>誰坐在教室裡</h2>
      <p class="lead">學員以 PGY2（內科組）為主體，佔全體四分之三；近半數（10 人）完全沒有接受過任何正式超音波課程。這是一個以「零基礎到低度接觸」為主的異質群體。</p>
    </div>

    <div class="kpi-grid">
      <button class="kpi" aria-expanded="false">
        <div class="n">21</div><div class="t">總填答人數</div>
        <div class="d">PGY2（內科組）16 人、內科 R3 3 人、內科 R2 2 人。R2/R3 僅 5 人，分組教學時需注意小組人數不均。</div>
      </button>
      <button class="kpi" aria-expanded="false">
        <div class="n">76<small>%</small></div><div class="t">PGY2 佔比</div>
        <div class="d">16 / 21。課程主要受眾為 PGY2，教材難度與臨床情境應以 PGY2 的病房需求為基準線。</div>
      </button>
      <button class="kpi" aria-expanded="false">
        <div class="n">48<small>%</small></div><div class="t">從未受過正式課程</div>
        <div class="d">10 / 21 選擇「無」。另有 7 人僅上過 1 次、4 人上過 2–5 次。正式訓練暴露量整體偏低且分佈不均。</div>
      </button>
      <button class="kpi" aria-expanded="false">
        <div class="n">2.67</div><div class="t">最低信心構面</div>
        <div class="d">「我能辨識正常與異常影像」平均僅 2.67 / 5，為三個構面中最低，且有 3 人自評為 1 分。</div>
      </button>
    </div>

    <div class="grid2" style="margin-top:22px">
      <div class="panel">
        <h3>學員身分組成</h3>
        <div class="chart-box"><canvas id="chartRole"></canvas></div>
      </div>
      <div class="panel">
        <h3>過去正式超音波課程經驗</h3>
        <div class="chart-box"><canvas id="chartCourse"></canvas></div>
      </div>
    </div>
  </div>
</section>

<!-- CHAPTER II -->
<section id="c2">
  <div class="wrap">
    <div class="head">
      <span class="chapnum">Chapter II</span>
      <h2>技能基線：三項操作的落差</h2>
      <p class="lead">Ascites echo 與 tapping 已有 9 人自評「可獨立完成」，但 Liver / biliary / gallbladder echo 僅 3 人——器官系統性掃描是最明顯的能力缺口。</p>
    </div>

    <div class="panel">
      <h3>Echo Procedure 自評熟練度分佈（人數）</h3>
      <div class="chart-box tall"><canvas id="chartProc"></canvas></div>
    </div>

    <div class="mini-grid">
      <div class="mini"><h4>Ascites echo</h4><p>可獨立 9 · 指導下 5 · 看過 5 · 從未 2。腹水偵測是最熟悉的技能。</p></div>
      <div class="mini"><h4>Ascites tapping</h4><p>可獨立 9 · 指導下 3 · 看過 8 · 從未 1。「看過但沒做過」的比例偏高。</p></div>
      <div class="mini"><h4>Liver / biliary</h4><p>可獨立 3 · 指導下 10 · 看過 8 · 從未 0。全體都接觸過，但幾乎無人能獨立完成。</p></div>
      <div class="mini"><h4>能力天花板</h4><p>三項中僅 3 人（14%）在肝膽項目達獨立層級，明顯低於腹水項目的 43%。</p></div>
    </div>

    <div class="findings">
      <h3>Key Finding</h3>
      <ul>
        <li><b>技能呈「點狀」而非「系統性」</b>：學員會做單一目標導向的腹水偵測與抽腹水，但不會完整、有順序地掃描整個腹部器官。</li>
        <li><b>Liver/biliary 是共同缺口</b>：無人「從未」接觸，卻只有 3 人可獨立，代表大量學員停留在「跟著看」的階段，缺乏被指導下的反覆練習機會。</li>
      </ul>
    </div>
  </div>
</section>

<!-- CHAPTER III -->
<section id="c3">
  <div class="wrap">
    <div class="head">
      <span class="chapnum">Chapter III</span>
      <h2>自我效能：手會動，眼睛還沒跟上</h2>
      <p class="lead">三個信心構面呈現一致的梯度：操作探頭（3.19）＞ 整合決策（2.81）＞ 辨識影像（2.67）。學員對「按鈕與探頭」比對「影像意義」更有把握。</p>
    </div>

    <div class="grid2">
      <div class="panel">
        <h3>三構面平均信心（1–5）</h3>
        <div class="chart-box"><canvas id="chartConf"></canvas></div>
      </div>
      <div class="panel">
        <h3>信心分數分佈（人數）</h3>
        <div class="chart-box"><canvas id="chartConfDist"></canvas></div>
      </div>
    </div>

    <div class="panel" style="margin-top:20px">
      <h3>次族群比較：正式課程經驗 × 身分</h3>
      <div class="chart-box"><canvas id="chartSub"></canvas></div>
    </div>

    <div class="findings">
      <h3>Key Finding</h3>
      <ul>
        <li><b>判讀信心是全體最弱環節</b>：辨識異常影像平均 2.67，且無人給 5 分；11 人集中在 3 分，代表「不確定自己看的對不對」是普遍狀態。</li>
        <li><b>正式課程經驗帶來的增益有限</b>：有課程經驗者三構面為 3.36 / 2.82 / 3.09，無經驗者為 3.00 / 2.50 / 2.50——差距不到 0.6 分，顯示過去單次課程未能有效轉化為判讀信心。</li>
        <li><b>年資效果集中在操作面</b>：R2/R3 在探頭設定達 4.00，明顯高於 PGY2 的 2.94；但在辨識影像上兩組同為 3.00 上下，資深者的優勢並未延伸到判讀。</li>
      </ul>
    </div>
  </div>
</section>

<!-- CHAPTER IV -->
<section id="c4">
  <div class="wrap">
    <div class="head">
      <span class="chapnum">Chapter IV</span>
      <h2>他們為什麼來</h2>
      <p class="lead">動機高度集中且務實：全體 21 人都選擇「提升臨床判斷能力」，17 人為「值班／急救做準備」。這是一群為了明天的班表而學習的人。</p>
    </div>

    <div class="grid2">
      <div class="panel">
        <h3>參加動機（可複選，人數）</h3>
        <div class="chart-box"><canvas id="chartMotive"></canvas></div>
      </div>
      <div class="panel">
        <h3>動機結構解讀</h3>
        <div class="mini-grid" style="margin-top:0">
          <div class="mini"><h4>100% 臨床判斷</h4><p>全體一致，無例外。課程若偏重儀器原理將與需求脫節。</p></div>
          <div class="mini"><h4>81% 值班急救</h4><p>17 人。情境教學應以值班常見情境（腹脹、腹痛、腹水）為骨幹。</p></div>
          <div class="mini"><h4>19% 純粹興趣</h4><p>4 人，屬於高度自發的核心學員，可作為進階組或種子教師人選。</p></div>
          <div class="mini"><h4>5% 應付考核</h4><p>僅 1 人。外在動機極低，內在動機強——有利於採用挑戰性較高的實作評量。</p></div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- CHAPTER V -->
<section id="c5">
  <div class="wrap">
    <div class="head">
      <span class="chapnum">Chapter V</span>
      <h2>他們想學什麼：開放式回答</h2>
      <p class="lead">21 則開放式回答編碼後，最高頻主題為「影像判讀與異常辨識」（7 則），其次為「探頭操作與影像品質」與「臨床決策與處置」（各 4 則）。點選標籤篩選。</p>
    </div>

    <div class="panel">
      <h3>質性主題分佈</h3>
      <div class="chart-box"><canvas id="chartTheme"></canvas></div>
    </div>

    <div style="margin-top:26px">
      <div class="filters" id="quoteFilters"></div>
      <div class="quote-grid" id="quoteGrid"></div>
    </div>
  </div>
</section>

<!-- CHAPTER VI -->
<section id="c6">
  <div class="wrap">
    <div class="head">
      <span class="chapnum">Chapter VI</span>
      <h2>逐筆資料與課程設計啟示</h2>
      <p class="lead">下方為 21 筆完整回覆，可依身分或課程經驗篩選；末段為由資料導出的課程設計建議。</p>
    </div>

    <div class="panel">
      <h3>原始回覆總表</h3>
      <div class="filters" id="rowFilters">
        <button class="filter-btn active" data-f="all">全部 (21)</button>
        <button class="filter-btn" data-f="PGY2">PGY2 (16)</button>
        <button class="filter-btn" data-f="R">內科 R2/R3 (5)</button>
        <button class="filter-btn" data-f="none">無課程經驗 (10)</button>
        <button class="filter-btn" data-f="some">有課程經驗 (11)</button>
      </div>
      <div class="tbl-scroll">
        <table>
          <thead><tr>
            <th>#</th><th>身分</th><th>課程經驗</th><th>Ascites echo</th><th>Tapping</th><th>Liver/biliary</th>
            <th>探頭</th><th>判讀</th><th>決策</th>
          </tr></thead>
          <tbody id="rowBody"></tbody>
        </table>
      </div>
    </div>

    <div class="duo">
      <div class="panel">
        <h3 class="ok">課程可以站上的基礎</h3>
        <ul>
          <li><b>動機一致且務實</b>——不需花時間說服學員為何要學。</li>
          <li><b>腹水評估已有共同基礎</b>——43% 可獨立操作，可作為熱身與同儕教學題材。</li>
          <li><b>全體都接觸過肝膽掃描</b>——非從零開始，可直接進入結構化訓練。</li>
          <li><b>外在動機極低</b>——適合採用形成性回饋而非高風險考試。</li>
        </ul>
      </div>
      <div class="panel">
        <h3 class="gap">必須優先補起的缺口</h3>
        <ul>
          <li><b>影像判讀信心最低（2.67）</b>——需要大量正常／異常對照與思考流程訓練。</li>
          <li><b>缺乏系統性掃描順序</b>——多位學員明確要求「完整掃完整個腹部」的步驟。</li>
          <li><b>影像品質與探頭擺位</b>——4 則回答直指取像技巧，屬於可快速改善的低垂果實。</li>
          <li><b>判讀到處置的連結</b>——學員要的不只是看見，而是「看見之後怎麼辦」。</li>
        </ul>
      </div>
    </div>

    <div class="verdict">
